<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout style="@style/UiKit.GuildsListItem"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/guilds_item_folder_container" android:background="@drawable/drawable_squircle_transparent" android:layout_width="@dimen/avatar_size_large" android:layout_height="@dimen/avatar_size_large" android:layout_centerInParent="true">
